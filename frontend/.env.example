# Leave unset for local dev — Vite proxies /api to the backend (see vite.config.js).
# In production, point this at your deployed backend's origin:
# VITE_API_URL=https://famous-hardware-api.vercel.app/api
VITE_API_URL=

# WhatsApp number that receives "Order via WhatsApp" messages from the storefront.
# Digits only, with country code, no + or spaces, e.g. 919876543210
VITE_WHATSAPP_NUMBER=

# Cloudinary cloud name (same one used by the backend) and an UNSIGNED upload preset, used to
# upload shop gallery videos directly from the browser to Cloudinary — bypassing the backend
# entirely so large video files don't hit the serverless function's request-size/time limits.
# Create the preset at Cloudinary Dashboard -> Settings -> Upload -> Upload presets -> Add
# upload preset -> Signing Mode: Unsigned. These are safe to expose publicly; unsigned presets
# only allow uploads, not reads/deletes of your account.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
